APP_ENV=development
# Use the EXISTING Neon connection string, including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-EXISTING-NEON-HOST/DBNAME?sslmode=require
SESSION_SECRET_KEY=replace-with-a-random-deployment-secret
AUTH_RATE_LIMIT_ENABLED=true
CSRF_PROTECTION_ENABLED=true
BUSINESS_TIMEZONE=Asia/Manila
# Only required if no inventory account exists; remove after first bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
